{
  "name": "CanonicalTemplateProfile",
  "type": "object",
  "title": "Canonical Template Profile",
  "description": "Reusable template, visual/profile rule, and separation policy for slides, packets, generated artifacts, AYA/CTS, and PRISM rails.",
  "properties": {
    "template_key": { "type": "string" },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "rail": {
      "type": "string",
      "enum": [
        "canonical",
        "aya",
        "prism",
        "AYA_Classroom",
        "PRISM_Framework",
        "CTS_RCS_Public_or_Open_Source",
        "Mixed"
      ]
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "public_demo",
        "canonical_internal",
        "aya_classroom",
        "prism_private"
      ]
    },
    "module_type": { "type": "string" },
    "artifact_type": {
      "type": "string",
      "maxLength": 100
    },
    "output_types": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "template_url": {
      "type": "string",
      "format": "uri"
    },
    "instructions": {
      "type": "string",
      "maxLength": 12000
    },
    "style_rules": { "type": "object" },
    "forbidden_content_rules": { "type": "object" },
    "default_export_behavior": { "type": "object" },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": [
    "rail"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
