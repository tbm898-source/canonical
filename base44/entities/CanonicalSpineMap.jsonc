{
  "name": "CanonicalSpineMap",
  "type": "object",
  "title": "CANONICAL Spine Map",
  "description": "Owner-approved map of the discovered Dropbox CANONICAL spine. Contains safe metadata only.",
  "properties": {
    "root_name": { "type": "string" },
    "root_path": { "type": "string" },
    "candidate_roots": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "detected_folders": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "missing_expected_folders": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "recommended_paths": {
      "type": "object",
      "properties": {
        "canonical_internal": { "type": "string" },
        "aya_classroom": { "type": "string" },
        "prism_private": { "type": "string" },
        "public_demo": { "type": "string" }
      }
    },
    "accepted_by_owner": { "type": "boolean", "default": false },
    "accepted_at": { "type": "string" },
    "connector_mode": {
      "type": "string",
      "enum": ["owner_preview", "owner_live_dropbox"],
      "default": "owner_preview"
    },
    "discovery_warnings": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": ["root_name", "root_path", "recommended_paths", "accepted_by_owner"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
