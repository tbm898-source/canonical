{
  "name": "CanonicalGeneratedArtifact",
  "type": "object",
  "title": "Canonical Generated Artifact",
  "description": "Generated curriculum, packet, slide, quiz, manifest, operator, and connector-safe artifact metadata. Never stores connector secrets.",
  "properties": {
    "artifact_id": { "type": "string" },
    "request_id": { "type": "string" },
    "module_key": { "type": "string" },
    "session_key": { "type": "string" },
    "session_title": { "type": "string" },
    "session_date": { "type": "string" },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "rail": {
      "type": "string",
      "enum": [
        "canonical",
        "aya",
        "prism",
        "AYA_Classroom",
        "PRISM_Framework",
        "CTS_RCS_Public_or_Open_Source",
        "Mixed"
      ]
    },
    "visibility_scope": {
      "type": "string",
      "enum": [
        "public_demo",
        "canonical_internal",
        "aya_classroom",
        "prism_private"
      ]
    },
    "privacy_level": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted"
      ],
      "default": "internal"
    },
    "audience": {
      "type": "string",
      "enum": [
        "student",
        "instructor",
        "facilitator",
        "operator",
        "admin",
        "public",
        "mixed"
      ],
      "default": "instructor"
    },
    "artifact_type": {
      "type": "string",
      "maxLength": 100
    },
    "filename": {
      "type": "string",
      "maxLength": 240
    },
    "format": {
      "type": "string",
      "enum": [
        "markdown",
        "pdf",
        "docx",
        "pptx",
        "slide_outline",
        "json",
        "zip",
        "text"
      ],
      "default": "markdown"
    },
    "content": {
      "type": "string",
      "maxLength": 60000
    },
    "generated_json": { "type": "object" },
    "generated_markdown": { "type": "string" },
    "manifest": { "type": "object" },
    "export_manifest": { "type": "object" },
    "dropbox_path": { "type": "string" },
    "manifest_path": { "type": "string" },
    "classroom_draft": { "type": "object" },
    "clickup_task_candidates": {
      "type": "array",
      "items": { "type": "object" },
      "default": []
    },
    "connector_mode": { "type": "string" },
    "owner_attribution": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "default": "v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "prepared",
        "review",
        "approved",
        "published",
        "saved",
        "blocked",
        "error",
        "archived"
      ],
      "default": "draft"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": [
    "rail",
    "artifact_type"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
