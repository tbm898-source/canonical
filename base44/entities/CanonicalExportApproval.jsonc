{
  "name": "CanonicalExportApproval",
  "type": "object",
  "title": "CANONICAL Export Approval",
  "description": "Owner approval record for live connector exports and dry-run target previews.",
  "properties": {
    "artifact_id": { "type": "string" },
    "export_type": { "type": "string" },
    "target_service": {
      "type": "string",
      "enum": ["dropbox", "google_classroom", "clickup", "gmail"]
    },
    "target_path_or_id": { "type": "string" },
    "approval_status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "not_required"],
      "default": "pending"
    },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string" },
    "notes": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": ["artifact_id", "export_type", "target_service", "approval_status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
