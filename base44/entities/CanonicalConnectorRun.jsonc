{
  "name": "CanonicalConnectorRun",
  "type": "object",
  "title": "CANONICAL Connector Run",
  "description": "Safe connector audit record with no OAuth tokens, backend logs, or raw private API responses.",
  "properties": {
    "run_id": { "type": "string" },
    "connector": {
      "type": "string",
      "enum": ["dropbox", "google_classroom", "clickup", "gmail", "system"]
    },
    "function_name": { "type": "string" },
    "mode": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["idle", "checking", "discovered", "ready", "blocked", "saving", "saved", "preparing", "prepared", "error"]
    },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "user_visible_summary": { "type": "string" },
    "safe_metadata": { "type": "object" },
    "error_message": { "type": "string" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "required": ["run_id", "connector", "function_name", "mode", "status", "started_at"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
