{
  "name": "CanonicalModule",
  "type": "object",
  "title": "Canonical Module",
  "description": "Module or course unit inside a CanonicalProgram.",
  "properties": {
    "program_key": { "type": "string", "maxLength": 100 },
    "module_key": { "type": "string", "maxLength": 120 },
    "title": { "type": "string", "maxLength": 200 },
    "status": { "type": "string", "maxLength": 100 },
    "description": { "type": "string", "maxLength": 4000 },
    "visibility_scope": {
      "type": "string",
      "enum": ["public_demo", "canonical_internal", "aya_classroom", "prism_private"]
    },
    "canonical_path": { "type": "string", "maxLength": 500 },
    "source_version": { "type": "string", "maxLength": 80 },
    "created_from_import_id": { "type": "string", "maxLength": 160 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "required": [
    "program_key",
    "module_key",
    "title",
    "visibility_scope"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
